{
  "name": "i18n-bonsai",
  "description": "Desktop app for editing i18n translation JSON files",
  "productName": "i18n Bonsai",
  "author": "Jost Muxfeldt",
  "version": "1.0.3",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview": "npm run build && vite preview --port 8080 --host localhost",
    "lint:script": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:style": "stylelint src/**/*.{css,scss,vue}",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@mdi/font": "^5.9.55",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/node": "^17.0.18",
    "@vitejs/plugin-vue": "^1.10.2",
    "@vue/tsconfig": "^0.1.3",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "virtua": "^0.49.1",
    "vite": "^2.7.13",
    "vue": "^3.2.31",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.0",
    "@types/jsdom": "^16.2.14",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "@vue/test-utils": "^2.0.0-0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^8.0.3",
    "jsdom": "^19.0.0",
    "lint-staged": "^11.2.6",
    "postcss-html": "^1.3.0",
    "prettier": "^2.4.1",
    "pug": "^3.0.3",
    "sass": "^1.85.1",
    "simple-git-hooks": "^2.7.0",
    "stylelint": "^14.5.1",
    "stylelint-config-recommended": "^7.0.0",
    "stylelint-config-standard": "^25.0.0",
    "typescript": "^5.8.2",
    "vite-plugin-pug": "^0.4.1",
    "vite-plugin-vue-pug-indent-fix": "github:jmuxfeldt/vite-plugin-vue-pug-indent-fix",
    "vitest": "^0.4.1",
    "vue-tsc": "^2.2.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": ""
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": "eslint --fix",
    "*.{css,scss,vue}": "stylelint --fix",
    "*": "prettier --write"
  }
}
